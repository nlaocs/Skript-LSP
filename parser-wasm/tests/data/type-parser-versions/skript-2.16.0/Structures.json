  "kind" : "structure",
  "registrationOrder" : 7,
  "name" : "Event",
  "elementClass" : "ch.njol.skript.structures.StructEvent",
  "superClass" : "org.skriptlang.skript.lang.structure.Structure",
  "since" : [ "1.0", "2.6 (per-event priority)", "2.9 (listening to cancellable events)" ],
  "description" : [ "The structure used for listening to events.\n\nOptionally allows specifying whether to listen to events that have been cancelled, and allows specifying with which priority to listen to events. Events are called in the following order of priorities.\n\n```\nlowest -> low -> normal -> high -> highest -> monitor\n```\n\nModifying event-values or cancelling events is not supported when using the 'monitor' priority. It should only be used for monitoring the outcome of an event.\n" ],
  "examples" : [ "on load:\n\tbroadcast \"loading!\"\n", "on join:\n\tif {first-join::%player's uuid%} is not set:\n\t\tset {first-join::%player's uuid%} to now\n", "cancelled block break:\n\tsend \"<red>You can't break that here\" to player\n", "on join with priority lowest:\n\t# called first\n\non join:\n\t# called second\n\non join with priority highest:\n\t# called last\n" ],
  "noDoc" : false,
  "deprecated" : false,
  "priorityStr" : "SyntaxInfos.PATTERN_MATCHES_EVERYTHING",
  "priority" : {
    "after" : [ {
      "after" : [ {
        "after" : [ ],
        "before" : [ ]
      } ],
      "before" : [ ]
    }, {
      "after" : [ ],
      "before" : [ ]
    } ],
    "before" : [ ]
  },
  "patterns" : [ "[on] [:uncancelled|:cancelled|any:(any|all)] <.+> [priority:with priority (:(lowest|low|normal|high|highest|monitor))]" ],
  "addon" : {
    "name" : "Skript",
    "version" : "2.16.0"
  },
  "definitionId" : "structure:skript:3b4e047746082c6e758fb79207b7aa56b94b93eef3d4bf71203f9ee938716fa0",
