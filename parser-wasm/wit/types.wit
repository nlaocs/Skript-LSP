package nlaocs:skript-parser-addon@0.5.0;

interface types {
    record abi-version {
        major: u16,
        minor: u16,
    }

    record capability {
        id: string,
        version: u32,
    }

    record capability-requirement {
        id: string,
        minimum-version: u32,
        required: bool,
    }

    enum state-namespace-visibility {
        private,
        shared,
    }

    record state-namespace-declaration {
        name: string,
        visibility: state-namespace-visibility,
        schema-id: string,
        schema-version: u32,
        readers: list<string>,
        writers: list<string>,
    }

    record host-profile {
        abi: abi-version,
        capabilities: list<capability>,
    }

    enum syntax-kind {
        event,
        condition,
        effect,
        expression,
        %type,
        function,
        section,
        structure,
    }

    enum dynamic-multiplicity {
        single,
        multiple,
        both,
    }

    record dynamic-syntax-id {
        component-id: option<string>,
        local-id: string,
    }

    variant dynamic-syntax-reference {
        dynamic(dynamic-syntax-id),
        definition-id(string),
        registration-id(string),
    }

    record metadata-entry {
        key: string,
        value: string,
    }

    record dynamic-syntax-definition {
        local-id: string,
        kind: syntax-kind,
        patterns: list<string>,
        priority: s32,
        before: list<dynamic-syntax-reference>,
        after: list<dynamic-syntax-reference>,
        return-type: option<string>,
        return-multiplicity: option<dynamic-multiplicity>,
        handler: string,
        metadata: list<metadata-entry>,
    }

    variant dynamic-syntax-override-target {
        definition-id(string),
        registration-id(string),
    }

    record dynamic-syntax-override {
        local-id: string,
        target: dynamic-syntax-override-target,
        priority: s32,
        handler: string,
        metadata: list<metadata-entry>,
    }

    enum dynamic-registry-error-kind {
        unavailable,
        no-active-update,
        frozen,
        duplicate-id,
        unknown-id,
        invalid-input,
        invalid-pattern,
        unknown-reference,
        priority-cycle,
        stale-document-revision,
        internal,
    }

    record dynamic-registry-error {
        kind: dynamic-registry-error-kind,
        message: string,
    }

    variant hook-target {
        syntax-definition(syntax-kind),
        exact-registration(string),
        parse-stage,
    }

    enum hook-phase {
        document,
        preprocess,
        line,
        tree,
        node,
        matching,
        expression,
        capture,
        syntax,
        candidate,
        scope,
        ast,
        diagnostic,
    }

    enum hook-mode {
        observe,
        transform,
        override,
    }

    record hook-subscription {
        id: string,
        target: hook-target,
        phase: hook-phase,
        priority: s32,
        mode: hook-mode,
        capability-id: string,
    }

    record component-manifest {
        component-id: string,
        component-version: string,
        abi: abi-version,
        capabilities: list<capability-requirement>,
        subscriptions: list<hook-subscription>,
        state-namespaces: list<state-namespace-declaration>,
    }

    enum compatibility-error-kind {
        abi-version-mismatch,
        missing-capability,
        capability-version-too-old,
        invalid-manifest,
    }

    record compatibility-error {
        kind: compatibility-error-kind,
        subject: string,
        message: string,
    }

    enum state-scope {
        invocation,
        parse,
        document,
        project,
        persistent-project,
    }

    enum state-encoding {
        raw,
        cbor,
        json,
    }

    record state-value {
        schema-id: string,
        encoding: state-encoding,
        bytes: list<u8>,
    }

    record state-entry {
        key: string,
        value: state-value,
    }

    enum state-error-kind {
        no-active-transaction,
        invalid-input,
        unknown-namespace,
        access-denied,
        schema-mismatch,
        quota-exceeded,
        stale-document-revision,
        transaction-conflict,
        persistence,
        internal,
    }

    record state-error {
        kind: state-error-kind,
        message: string,
    }

    record text-range {
        start: u64,
        end: u64,
    }

    type expansion-id = u64;
    type syntax-context-id = u64;
    type node-id = u64;

    enum origin-kind {
        exact,
        replaced,
        anchored,
    }

    record source-origin {
        original-range: text-range,
        kind: origin-kind,
        expansion: option<expansion-id>,
    }

    record mapped-span {
        virtual-range: text-range,
        origins: list<source-origin>,
    }

    record invocation-context {
        invocation-id: u64,
        subscription-id: string,
        document-id: string,
        document-revision: u64,
        expansion: option<expansion-id>,
        syntax-context: syntax-context-id,
    }

    enum diagnostic-severity {
        error,
        warning,
        information,
        hint,
    }

    record related-span {
        message: string,
        span: mapped-span,
    }

    record diagnostic {
        code: string,
        message: string,
        severity: diagnostic-severity,
        span: mapped-span,
        related: list<related-span>,
    }

    record rejection {
        reason: string,
        diagnostics: list<diagnostic>,
    }

    variant hook-decision {
        continue-processing,
        handled,
        reject(rejection),
    }

    record context-update {
        syntax-context: syntax-context-id,
        key: string,
        value: option<list<u8>>,
    }

    enum parse-request-kind {
        expression,
        condition,
        line,
        tree,
        ast,
    }

    record parse-request {
        request-id: u64,
        kind: parse-request-kind,
        input: string,
        expected-types: list<string>,
        span: mapped-span,
    }

    record hook-effects {
        diagnostics: list<diagnostic>,
        context-updates: list<context-update>,
        parse-requests: list<parse-request>,
    }

    record expression-expected-type {
        class-name: string,
        plural: bool,
    }

    enum expression-leaf-kind {
        variable,
        literal,
        function,
        custom,
    }

    record expression-leaf-candidate {
        parser-id: string,
        kind: expression-leaf-kind,
        range: text-range,
        return-type: option<string>,
        multiplicity: option<dynamic-multiplicity>,
        metadata: list<metadata-entry>,
    }

    record expression-payload {
        input: string,
        remaining: text-range,
        span: mapped-span,
        expected-types: list<expression-expected-type>,
        candidate-ends: list<u64>,
        allow-literals: bool,
        allow-expressions: bool,
        time: s32,
        depth: u32,
        candidates: list<expression-leaf-candidate>,
    }

    enum line-ending {
        none,
        lf,
        cr-lf,
        cr,
    }

    enum indent-kind {
        space,
        tab,
    }

    record indentation {
        kind: indent-kind,
        unit: string,
    }

    enum raw-trivia-kind {
        whitespace,
        line-comment,
        block-comment,
        line-ending,
    }

    record raw-trivia {
        kind: raw-trivia-kind,
        text: string,
        span: mapped-span,
    }

    record raw-line {
        number: u64,
        raw-text: string,
        line-ending: line-ending,
        span: mapped-span,
        content-span: mapped-span,
        line-ending-span: mapped-span,
        indentation: raw-trivia,
        trailing-trivia: list<raw-trivia>,
    }

    enum raw-node-kind {
        blank,
        comment,
        simple,
        section,
        invalid,
    }

    record unexpected-indentation {
        expected-level: u32,
        actual-level: u32,
    }

    variant raw-invalid-reason {
        mixed-indentation,
        invalid-indentation,
        unexpected-indentation(unexpected-indentation),
    }

    enum raw-diagnostic-code {
        mixed-indentation,
        invalid-indentation,
        unexpected-indentation,
        empty-section,
        unclosed-block-comment,
    }

    enum raw-diagnostic-severity {
        error,
        warning,
    }

    record raw-related-span {
        message: string,
        span: mapped-span,
    }

    record raw-diagnostic {
        code: raw-diagnostic-code,
        severity: raw-diagnostic-severity,
        message: string,
        span: mapped-span,
        related: list<raw-related-span>,
    }

    record raw-tree-node {
        id: node-id,
        kind: raw-node-kind,
        text: string,
        span: mapped-span,
        line: raw-line,
        code-span: option<mapped-span>,
        header-span: option<mapped-span>,
        body-span: option<mapped-span>,
        indent-level: option<u32>,
        invalid-reason: option<raw-invalid-reason>,
        syntax-context: syntax-context-id,
        parent: option<node-id>,
        children: list<node-id>,
    }

    record raw-tree {
        roots: list<node-id>,
        nodes: list<raw-tree-node>,
        diagnostics: list<raw-diagnostic>,
        indentation: option<indentation>,
    }

    type generated-node-id = u64;

    enum generated-raw-node-kind {
        blank,
        comment,
        simple,
        section,
    }

    record generated-raw-node {
        id: generated-node-id,
        kind: generated-raw-node-kind,
        text: string,
        children: list<generated-node-id>,
    }

    record generated-raw-tree {
        roots: list<generated-node-id>,
        nodes: list<generated-raw-node>,
    }

    enum retained-children-placement {
        prepend,
        append,
    }

    record retained-children {
        target: generated-node-id,
        placement: retained-children-placement,
    }

    record replace-node-edit {
        replacement: generated-raw-tree,
        retained-children: option<retained-children>,
    }

    variant tree-edit {
        replace-node(replace-node-edit),
        replace-children(generated-raw-tree),
    }
    variant capture-value {
        text(string),
        node(node-id),
        nodes(list<node-id>),
        span(mapped-span),
    }

    record capture {
        name: string,
        value: capture-value,
    }

    record ast-node {
        id: node-id,
        kind: syntax-kind,
        syntax-id: string,
        span: mapped-span,
        syntax-context: syntax-context-id,
        captures: list<capture>,
        children: list<node-id>,
    }

    record ast-tree {
        roots: list<node-id>,
        nodes: list<ast-node>,
    }

    record syntax-definition-payload {
        kind: syntax-kind,
        syntax-id: string,
        patterns: list<string>,
    }

    record exact-registration-payload {
        registration-id: string,
        definition: syntax-definition-payload,
    }

    record document-payload {
        text: string,
    }

    record preprocess-payload {
        text: string,
        span: mapped-span,
    }

    record line-payload {
        line-number: u64,
        text: string,
        span: mapped-span,
    }

    record node-payload {
        node: raw-tree-node,
    }

    enum matching-scope {
        definition,
        registration,
        pattern,
        element,
    }

    enum matching-timing {
        before,
        after,
    }

    enum matching-status {
        pending,
        matched,
        failed,
    }

    variant matching-path-segment {
        element(u32),
        branch(u32),
    }

    record matching-payload {
        input: string,
        pattern: option<string>,
        definition-id: string,
        registration-id: string,
        pattern-index: option<u64>,
        element-path: list<matching-path-segment>,
        pattern-span: option<text-range>,
        scope: matching-scope,
        timing: matching-timing,
        input-range: text-range,
        span: mapped-span,
        status: matching-status,
        failure-reason: option<string>,
    }

    record capture-payload {
        syntax-id: string,
        captures: list<capture>,
        span: mapped-span,
    }

    record candidate-payload {
        syntax-id: string,
        registration-id: string,
        score: s64,
        span: mapped-span,
    }

    record scope-payload {
        scope-id: u64,
        parent-scope: option<u64>,
        span: mapped-span,
    }

    variant hook-payload {
        document(document-payload),
        preprocess(preprocess-payload),
        line(line-payload),
        tree(raw-tree),
        node(node-payload),
        matching(matching-payload),
        expression(expression-payload),
        capture(capture-payload),
        syntax(syntax-definition-payload),
        exact-registration(exact-registration-payload),
        candidate(candidate-payload),
        scope(scope-payload),
        ast(ast-tree),
        diagnostic(diagnostic),
    }

    record hook-invocation {
        context: invocation-context,
        target: hook-target,
        phase: hook-phase,
        payload: hook-payload,
    }

    record hook-output {
        decision: hook-decision,
        replacement: option<hook-payload>,
        effects: hook-effects,
    }

    record text-edit {
        range: text-range,
        replacement: string,
        anchor: option<u64>,
    }

    record text-macro-input {
        context: invocation-context,
        text: string,
        span: mapped-span,
    }

    record text-macro-output {
        decision: hook-decision,
        edits: list<text-edit>,
        effects: hook-effects,
    }

    record tree-macro-input {
        context: invocation-context,
        tree: raw-tree,
        target: node-id,
        depth: u32,
    }

    record tree-macro-output {
        decision: hook-decision,
        edit: option<tree-edit>,
        effects: hook-effects,
    }
    record ast-macro-input {
        context: invocation-context,
        tree: ast-tree,
    }

    record ast-macro-output {
        decision: hook-decision,
        replacement: option<ast-tree>,
        effects: hook-effects,
    }

    enum addon-error-kind {
        incompatible-abi,
        unsupported-capability,
        unsupported-hook,
        invalid-payload,
        internal,
    }

    record addon-error {
        kind: addon-error-kind,
        message: string,
        diagnostics: list<diagnostic>,
    }
}
