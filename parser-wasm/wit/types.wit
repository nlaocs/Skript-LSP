package nlaocs:skript-parser-addon@0.29.0;

interface types {
    /// Stable location of one top-level SSG JSON object in an exact retained source.
    record catalog-record-ref {
        source-digest: string,
        snapshot-id: string,
        document: string,
        index: u64,
        byte-length: u64,
    }

    record abi-version {
        major: u16,
        minor: u16,
    }

    record capability {
        id: string,
        version: u32,
    }

    record capability-requirement {
        id: string,
        minimum-version: u32,
        required: bool,
    }

    enum state-namespace-visibility {
        private,
        shared,
    }

    record state-namespace-declaration {
        name: string,
        visibility: state-namespace-visibility,
        schema-id: string,
        schema-version: u32,
        readers: list<string>,
        writers: list<string>,
    }

    record runtime-plugin {
        load-order: u64,
        name: string,
        version: string,
        main: string,
    }

    record runtime-profile {
        snapshot-schema-version: option<u32>,
        snapshot-id: option<string>,
        server-name: option<string>,
        server-version: option<string>,
        minecraft-version: option<string>,
        java-version: option<string>,
        language: option<string>,
        skript-version: option<string>,
        plugins: list<runtime-plugin>,
    }

    record registered-handler-binding {
        handler-id: string,
        definition-ids: list<string>,
        registration-ids: list<string>,
    }

    record host-profile {
        abi: abi-version,
        capabilities: list<capability>,
        runtime: runtime-profile,
        registered-handler-bindings: list<registered-handler-binding>,
    }

    enum syntax-kind {
        event,
        condition,
        effect,
        expression,
        %type,
        function,
        section,
        structure,
    }

    enum dynamic-multiplicity {
        single,
        multiple,
        both,
    }

    record dynamic-syntax-id {
        component-id: option<string>,
        local-id: string,
    }

    variant dynamic-syntax-reference {
        dynamic(dynamic-syntax-id),
        definition-id(string),
        registration-id(string),
    }

    record metadata-entry {
        key: string,
        value: string,
        owner-component-id: option<string>,
    }

    record dynamic-syntax-definition {
        local-id: string,
        kind: syntax-kind,
        patterns: list<string>,
        priority: s32,
        before: list<dynamic-syntax-reference>,
        after: list<dynamic-syntax-reference>,
        return-type: option<string>,
        return-multiplicity: option<dynamic-multiplicity>,
        structure-node-type: option<structure-node-type>,
        structure-body-mode: option<structure-body-mode>,
        entry-validator: option<structure-entry-validator>,
        handler: string,
        metadata: list<metadata-entry>,
    }

    variant dynamic-syntax-override-target {
        definition-id(string),
        registration-id(string),
    }

    record dynamic-syntax-override {
        local-id: string,
        target: dynamic-syntax-override-target,
        priority: s32,
        handler: string,
        metadata: list<metadata-entry>,
    }

    enum dynamic-registry-error-kind {
        unavailable,
        no-active-update,
        frozen,
        duplicate-id,
        unknown-id,
        invalid-input,
        invalid-pattern,
        unknown-reference,
        priority-cycle,
        stale-document-revision,
        internal,
    }

    record dynamic-registry-error {
        kind: dynamic-registry-error-kind,
        message: string,
    }

    variant hook-target {
        syntax-kind(syntax-kind),
        definition(string),
        registration(string),
        pattern(pattern-ref),
        parse-stage,
        parser(string),
    }

    record pattern-ref {
        registration-id: string,
        pattern-index: u64,
    }

    enum hook-phase {
        document,
        preprocess,
        line,
        tree,
        node,
        matching,
        expression,
        condition,
        effect,
        section,
        structure,
        capture,
        syntax,
        candidate,
        scope,
        ast,
        diagnostic,
        parser,
    }

    enum hook-mode {
        observe,
        transform,
        override,
    }

    enum selector-type-relation {
        exact,
        assignable,
        convertible,
    }

    record return-type-selector {
        class-name: string,
        relation: selector-type-relation,
    }

    record capture-selector {
        capture-index: u64,
        status: option<parse-result-status>,
    }

    record hook-selector {
        pattern-index: option<u64>,
        pattern-source: option<string>,
        mark: option<s32>,
        tags: list<string>,
        captures: list<capture-selector>,
        return-type: option<return-type-selector>,
        multiplicity: option<dynamic-multiplicity>,
        metadata: list<metadata-entry>,
    }

    record hook-subscription {
        id: string,
        target: hook-target,
        phase: hook-phase,
        priority: s32,
        mode: hook-mode,
        capability-id: string,
        selector: hook-selector,
    }

    /// A route used by a registered semantic handler.
    ///
    /// A handler may declare multiple targets. They are combined with OR
    /// semantics, so one handler can cover several static registrations and
    /// dynamic definitions at the same time.
    variant registered-syntax-handler-target {
        definition(string),
        registration(string),
        /// Matches every Type registration using this exact parser class.
        parser-class(string),
        class-suffix(string),
        /// Matches every static registration with this direct Java superclass.
        super-class(string),
        /// Matches the opaque handler ID of a dynamic syntax definition.
        dynamic-handler(string),
    }

    record capture-parser-binding {
        /// Zero-based index among every capture in pattern source order.
        /// Typed `%type%` captures and regex `<.+>` captures share this index.
        capture-index: u64,
        /// Open parser route such as `host.expression`.
        parser-id: string,
        /// Rejects the containing syntax candidate when this capture cannot parse.
        required: bool,
        /// Route-specific options. `host.expression` accepts `parse.mode`,
        /// `expression.expected-types`, `expression.time-state`, and temporary
        /// `context.*` overrides.
        options: list<metadata-entry>,
    }

    record registered-syntax-handler {
        handler-id: string,
        kind: syntax-kind,
        /// At least one target is required.
        targets: list<registered-syntax-handler-target>,
        /// Empty accepts every pattern; otherwise the matched index must occur here.
        pattern-indices: list<u64>,
        /// Empty accepts every pattern; otherwise the exact source must occur here.
        pattern-sources: list<string>,
        /// Every listed parse tag must be present on the matched branch.
        required-tags: list<string>,
        /// None of the listed parse tags may be present on the matched branch.
        forbidden-tags: list<string>,
        /// Empty accepts every aggregate ParseMark; otherwise one value must match.
        marks: list<s32>,
        capture-parsers: list<capture-parser-binding>,
        context-requirements: list<string>,
    }

    variant catalog-annotation-target {
        definition(string),
        registration(string),
        pattern(pattern-ref),
    }

    record catalog-annotation {
        target: catalog-annotation-target,
        metadata: list<metadata-entry>,
    }

    record component-manifest {
        component-id: string,
        component-version: string,
        abi: abi-version,
        capabilities: list<capability-requirement>,
        subscriptions: list<hook-subscription>,
        registered-syntax-handlers: list<registered-syntax-handler>,
        catalog-annotations: list<catalog-annotation>,
        state-namespaces: list<state-namespace-declaration>,
    }

    enum compatibility-error-kind {
        abi-version-mismatch,
        missing-capability,
        capability-version-too-old,
        invalid-manifest,
    }

    record compatibility-error {
        kind: compatibility-error-kind,
        subject: string,
        message: string,
    }

    enum state-scope {
        invocation,
        parse,
        document,
        project,
        persistent-project,
    }

    enum state-encoding {
        raw,
        cbor,
        json,
    }

    record state-value {
        schema-id: string,
        encoding: state-encoding,
        bytes: list<u8>,
    }

    record state-entry {
        key: string,
        value: state-value,
    }

    enum state-error-kind {
        no-active-transaction,
        invalid-input,
        unknown-namespace,
        access-denied,
        schema-mismatch,
        quota-exceeded,
        stale-document-revision,
        transaction-conflict,
        persistence,
        internal,
    }

    record state-error {
        kind: state-error-kind,
        message: string,
    }

    record text-range {
        start: u64,
        end: u64,
    }

    type expansion-id = u64;
    type syntax-context-id = u64;
    type node-id = u64;

    enum origin-kind {
        exact,
        replaced,
        anchored,
    }

    record source-origin {
        original-range: text-range,
        kind: origin-kind,
        expansion: option<expansion-id>,
    }

    record mapped-span {
        virtual-range: text-range,
        origins: list<source-origin>,
    }

    record invocation-context {
        invocation-id: u64,
        subscription-id: string,
        document-id: string,
        document-revision: u64,
        expansion: option<expansion-id>,
        syntax-context: syntax-context-id,
    }

    enum diagnostic-severity {
        error,
        warning,
        information,
        hint,
    }

    record related-span {
        message: string,
        span: mapped-span,
    }

    record diagnostic {
        code: string,
        message: string,
        severity: diagnostic-severity,
        span: mapped-span,
        related: list<related-span>,
    }

    record rejection {
        reason: string,
        diagnostics: list<diagnostic>,
    }

    variant hook-decision {
        continue-processing,
        not-applicable,
        handled,
        reject(rejection),
    }

    record context-update {
        syntax-context: syntax-context-id,
        key: string,
        value: option<list<u8>>,
    }

    record expression-expected-type {
        class-name: string,
        plural: bool,
    }

    record parse-request {
        request-id: u64,
        parser-id: string,
        input: string,
        expected-types: list<expression-expected-type>,
        span: mapped-span,
        options: list<metadata-entry>,
    }

    record hook-effects {
        diagnostics: list<diagnostic>,
        context-updates: list<context-update>,
        parse-requests: list<parse-request>,
        parse-results: list<parse-result>,
    }

    enum expression-leaf-kind {
        variable,
        literal,
        function,
        custom,
    }

    enum expression-leaf-timing {
        before-registered,
        after-registered,
    }

    record parse-result-reference {
        host-token: u64,
        root-id: u64,
    }

    /// Public semantic data, editable by subsequent Transform/Override hooks.
    /// A schema ID identifies a shared contract, not an owning component.
    /// Each list contains at most one entry per schema ID. Versions start at 1.
    /// The JSON must be an object; schema-specific meaning belongs to addons.
    /// Source text and spans remain immutable, even when semantic data changes.
    record expression-public-data {
        schema-id: string,
        schema-version: u32,
        json: string,
    }

    record expression-leaf-candidate {
        parser-id: string,
        kind: expression-leaf-kind,
        timing: expression-leaf-timing,
        range: text-range,
        return-type: option<string>,
        multiplicity: option<dynamic-multiplicity>,
        children: list<parse-result-reference>,
        public-data: list<expression-public-data>,
        metadata: list<metadata-entry>,
    }

    record expression-type-option {
        source-record: option<catalog-record-ref>,
        definition-id: string,
        registration-id: string,
        addon-name: string,
        addon-version: string,
        code-name: string,
        class-name: string,
        parser-class: option<string>,
        type-parse-order: u64,
        before: list<string>,
        after: list<string>,
        singular: string,
        plural: string,
        user-input-patterns: list<string>,
        has-parser: bool,
        parse-contexts: list<string>,
        has-supplier: bool,
    }

    enum expression-literal-source {
        parser-pattern,
        supplier,
        enum-constant,
        alias,
    }

    record expression-literal-option {
        source-record: option<catalog-record-ref>,
        literal-index: option<u64>,
        code-name: string,
        class-name: string,
        type-parse-order: u64,
        range: text-range,
        canonical-value: string,
        source: expression-literal-source,
        plural: bool,
        addon-name: string,
        addon-version: string,
        parser-class: option<string>,
        parse-contexts: list<string>,
        value-class: option<string>,
        represented-class: option<string>,
        variable-name: option<string>,
        debug-text: option<string>,
        enum-constant: option<string>,
        alias-all: option<bool>,
        alias-type-count: option<u64>,
    }

    record expression-payload {
        input: string,
        context: parse-context,
        active-type: option<expression-type-option>,
        remaining: text-range,
        span: mapped-span,
        expected-types: list<expression-expected-type>,
        candidate-ends: list<u64>,
        allow-literals: bool,
        allow-expressions: bool,
        time: s32,
        depth: u32,
        type-options: list<expression-type-option>,
        literal-options: list<expression-literal-option>,
        candidates: list<expression-leaf-candidate>,
    }

    enum expression-return-type-state {
        %static,
        dynamic,
        unresolved,
    }

    enum expression-possible-return-types-state {
        complete,
        partial,
        unresolved,
    }

    record registered-expression-child {
        text: string,
        kind: string,
        parser-id: option<string>,
        definition-id: option<string>,
        registration-id: option<string>,
        pattern-index: option<u64>,
        element-class: option<string>,
        return-type: option<string>,
        possible-return-types: list<string>,
        possible-return-types-state: expression-possible-return-types-state,
        multiplicity: option<dynamic-multiplicity>,
        public-data: list<expression-public-data>,
        metadata: list<metadata-entry>,
    }

    record registered-expression-tag {
        value: string,
        implicit: bool,
    }

    enum metadata-resolution-state {
        resolved,
        unresolved,
    }

    record accepted-change-mode {
        mode: string,
        accepted-types: list<string>,
    }

    record registered-expression-property-option {
        source-record: option<catalog-record-ref>,
        property-source-index: u64,
        related-type-index: u64,
        source-child-index: u64,
        match-kind: string,
        property-registration-id: string,
        property-name: string,
        property-handler-class: string,
        property-addon-name: string,
        property-addon-version: string,
        input-class: string,
        handler-class: string,
        handler-kind: string,
        provider-addon-name: option<string>,
        provider-addon-version: option<string>,
        type-code-name: string,
        element-types: list<string>,
        return-types: list<string>,
        supported-axes: list<string>,
        accepted-changers: list<accepted-change-mode>,
        accepted-changers-state: option<metadata-resolution-state>,
        requires-source-expression-change: option<bool>,
    }

    enum parse-result-status {
        success,
        partial,
        failed,
    }

    record addon-attachment {
        owner-component-id: string,
        schema-id: string,
        schema-version: u32,
        encoding: string,
        bytes: list<u8>,
    }

    record parse-summary {
        kind: string,
        definition-id: option<string>,
        registration-id: option<string>,
        element-class: option<string>,
        pattern-index: option<u64>,
        return-type: option<string>,
        possible-return-types: list<string>,
        possible-return-types-state: expression-possible-return-types-state,
        multiplicity: option<dynamic-multiplicity>,
        public-data: list<expression-public-data>,
        metadata: list<metadata-entry>,
    }

    record parsed-capture {
        capture-index: u64,
        parser-id: string,
        status: parse-result-status,
        text: string,
        span: mapped-span,
        expected-types: list<expression-expected-type>,
        summary: option<parse-summary>,
        attachments: list<addon-attachment>,
        diagnostics: list<diagnostic>,
    }

    record parse-result-node {
        node-id: u64,
        parser-id: string,
        kind: string,
        status: parse-result-status,
        text: string,
        span: mapped-span,
        expected-types: list<expression-expected-type>,
        summary: option<parse-summary>,
        children: list<u64>,
        attachments: list<addon-attachment>,
        diagnostics: list<diagnostic>,
        metadata: list<metadata-entry>,
    }

    record parse-result {
        host-token: u64,
        request-id: u64,
        parser-id: string,
        status: parse-result-status,
        roots: list<u64>,
        nodes: list<parse-result-node>,
        diagnostics: list<diagnostic>,
    }

    /// Immutable parser context visible to every syntax semantic hook.
    record parse-context-value {
        key: string,
        value: string,
    }

    record parse-context {
        syntax-context: syntax-context-id,
        event-classes: list<string>,
        values: list<parse-context-value>,
    }

    record registered-expression-payload {
        input: string,
        context: parse-context,
        /// Requested Skript time state: past=-1, present=0, future=1.
        time: s32,
        definition-id: string,
        registration-id: string,
        element-class: string,
        related-property: option<string>,
        pattern-index: u64,
        pattern: string,
        span: mapped-span,
        expected-types: list<expression-expected-type>,
        declared-return-type: option<string>,
        declared-multiplicity: option<dynamic-multiplicity>,
        return-type-state: expression-return-type-state,
        possible-return-types: list<string>,
        possible-return-types-state: expression-possible-return-types-state,
        regex-captures: list<string>,
        tags: list<registered-expression-tag>,
        mark: s32,
        children: list<registered-expression-child>,
        parsed-captures: list<parsed-capture>,
        common-child-return-type: option<string>,
        type-options: list<expression-type-option>,
        property-options: list<registered-expression-property-option>,
        /// Mutable selection into the immutable property-options list. Empty means no policy chose.
        selected-property-option-indices: list<u64>,
        effective-return-type: option<string>,
        effective-possible-return-types: list<string>,
        effective-possible-return-types-state: expression-possible-return-types-state,
        effective-multiplicity: option<dynamic-multiplicity>,
        public-data: list<expression-public-data>,
        metadata: list<metadata-entry>,
    }

    enum effect-timing {
        before,
        after,
    }

    record effect-regex-capture {
        pattern-span: text-range,
        value: string,
        span: mapped-span,
    }

    record effect-expression-capture {
        pattern-span: text-range,
        expression: string,
        value: string,
        span: mapped-span,
        alternative-index: option<u64>,
        resolution-id: option<string>,
    }

    variant effect-capture {
        regex(effect-regex-capture),
        expression(effect-expression-capture),
    }

    record effect-tag {
        value: string,
        pattern-span: text-range,
        input-span: mapped-span,
        implicit: bool,
    }

    record effect-mark {
        value: s32,
        pattern-span: text-range,
        input-span: mapped-span,
        accumulated: s32,
    }

    record effect-candidate {
        raw-node-id: node-id,
        definition-id: string,
        registration-id: string,
        element-class: option<string>,
        priority: s32,
        registration-order: u64,
        pattern-index: u64,
        pattern: string,
        span: mapped-span,
        captures: list<effect-capture>,
        tags: list<effect-tag>,
        mark: s32,
        marks: list<effect-mark>,
        handler: option<string>,
        metadata: list<metadata-entry>,
        parsed-captures: list<parsed-capture>,
    }

    record effect-failure {
        offset: u64,
        span: mapped-span,
        reasons: list<string>,
    }

    record effect-near-match {
        definition-id: string,
        registration-id: string,
        element-class: option<string>,
        priority: s32,
        registration-order: u64,
        resolved-order: option<u64>,
        handler: option<string>,
        metadata: list<metadata-entry>,
        failure: effect-failure,
    }

    record effect-payload {
        input: string,
        context: parse-context,
        raw-node-id: node-id,
        span: mapped-span,
        timing: effect-timing,
        candidate: option<effect-candidate>,
        alternatives: list<effect-candidate>,
        failure: option<effect-failure>,
        near-match: option<effect-near-match>,
    }

    record condition-regex-capture {
        pattern-span: text-range,
        value: string,
        span: mapped-span,
    }

    record condition-expression-capture {
        pattern-span: text-range,
        expression: string,
        value: string,
        span: mapped-span,
        alternative-index: option<u64>,
        resolution-id: option<string>,
    }

    variant condition-capture {
        regex(condition-regex-capture),
        expression(condition-expression-capture),
    }

    record condition-tag {
        value: string,
        pattern-span: text-range,
        input-span: mapped-span,
        implicit: bool,
    }

    record condition-mark {
        value: s32,
        pattern-span: text-range,
        input-span: mapped-span,
        accumulated: s32,
    }

    record condition-candidate {
        definition-id: string,
        registration-id: string,
        element-class: option<string>,
        priority: s32,
        registration-order: u64,
        pattern-index: u64,
        pattern: string,
        span: mapped-span,
        captures: list<condition-capture>,
        tags: list<condition-tag>,
        mark: s32,
        marks: list<condition-mark>,
        handler: option<string>,
        metadata: list<metadata-entry>,
        children: list<registered-expression-child>,
    }

    record condition-payload {
        input: string,
        context: parse-context,
        candidate: condition-candidate,
    }

    enum section-timing {
        enter-children,
        exit-children,
    }

    record syntax-tag {
        value: string,
        pattern-span: text-range,
        input-span: mapped-span,
        implicit: bool,
    }

    record syntax-mark {
        value: s32,
        pattern-span: text-range,
        input-span: mapped-span,
        accumulated: s32,
    }

    enum section-body-mode {
        trigger,
        conditions,
    }

    enum section-raw-node-kind {
        blank,
        comment,
        simple,
        section,
        invalid,
    }

    record section-raw-node {
        raw-node-id: node-id,
        kind: section-raw-node-kind,
        source: string,
        span: mapped-span,
    }

    record section-sibling {
        raw-node-id: node-id,
        definition-id: string,
        registration-id: string,
        element-class: option<string>,
        pattern-index: u64,
        source: string,
        span: mapped-span,
        handler: option<string>,
        metadata: list<metadata-entry>,
    }

    record section-candidate {
        raw-node-id: node-id,
        definition-id: string,
        registration-id: string,
        element-class: option<string>,
        pattern-index: u64,
        span: mapped-span,
        loop-section: bool,
        effect-section: bool,
        section-expression: bool,
        regex-captures: list<string>,
        tags: list<syntax-tag>,
        mark: s32,
        marks: list<syntax-mark>,
        parsed-captures: list<parsed-capture>,
        body-mode: section-body-mode,
        metadata: list<metadata-entry>,
    }

    record section-payload {
        input: string,
        context: parse-context,
        raw-node-id: node-id,
        span: mapped-span,
        timing: section-timing,
        preceding-siblings: list<section-sibling>,
        next-sibling: option<section-raw-node>,
        raw-children: list<section-raw-node>,
        candidate: section-candidate,
    }

    enum structure-node-type {
        simple,
        section,
        both,
    }

    enum structure-body-mode {
        none,
        raw,
        entries,
        trigger,
    }

    enum structure-timing {
        enter-body,
        exit-body,
    }

    enum structure-entry-kind {
        literal,
        variable-string,
        expression,
        trigger,
        container,
        section,
        key-value,
        unknown,
    }

    enum structure-entry-value-kind {
        raw,
        expression,
        trigger,
        container,
        section,
        unknown,
    }

    /// Complete declarative EntryValidator supplied by a dynamic Structure.
    ///
    /// The records are flattened. A root entry has no parent; a nested entry
    /// stores the zero-based index of its container EntryData in this list.
    record structure-entry-validator {
        entry-data: list<structure-entry-data>,
    }

    /// Lossless EntryData declaration used by a dynamic Structure.
    ///
    /// `default-value` contains the original JSON value as a JSON document,
    /// including JSON null and structured values.
    record structure-entry-data {
        parent-entry-index: option<u32>,
        key: string,
        default-value: option<string>,
        optional: bool,
        multiple: bool,
        entry-data-class: string,
        kind: structure-entry-kind,
        separator: option<string>,
        value-type: option<string>,
        string-mode: option<string>,
        return-types: list<string>,
        %flags: option<s32>,
        nested-validator-present: bool,
    }

    record structure-entry {
        raw-node-id: option<node-id>,
        parent-entry: option<u64>,
        key: string,
        entry-data-class: string,
        kind: structure-entry-kind,
        source: string,
        span: mapped-span,
        defaulted: bool,
        value-kind: structure-entry-value-kind,
        value-summary: option<parse-summary>,
    }

    enum function-declaration-scope {
        global,
        local,
    }

    record function-parameter-declaration {
        name: string,
        class-name: string,
        single: bool,
        default-source: option<string>,
    }

    record function-return-declaration {
        class-name: option<string>,
        single: bool,
    }

    record function-declaration {
        source: string,
        span: text-range,
        scope: function-declaration-scope,
        name: string,
        parameters: list<function-parameter-declaration>,
        returns: function-return-declaration,
        metadata: list<metadata-entry>,
    }

    variant parser-declaration {
        document-function(function-declaration),
    }

    record structure-candidate {
        raw-node-id: node-id,
        definition-id: string,
        registration-id: string,
        element-class: option<string>,
        priority: s32,
        registration-order: u64,
        pattern-index: u64,
        pattern: string,
        span: mapped-span,
        declared-node-type: structure-node-type,
        actual-node-type: structure-node-type,
        regex-captures: list<string>,
        tags: list<syntax-tag>,
        mark: s32,
        marks: list<syntax-mark>,
        parsed-captures: list<parsed-capture>,
        body-mode: structure-body-mode,
        child-node-ids: list<node-id>,
        entries: list<structure-entry>,
        handler: option<string>,
        metadata: list<metadata-entry>,
        declarations: list<parser-declaration>,
    }

    record structure-payload {
        input: string,
        body-tree: raw-tree,
        context: parse-context,
        timing: structure-timing,
        type-options: list<expression-type-option>,
        candidate: structure-candidate,
    }

    enum line-ending {
        none,
        lf,
        cr-lf,
        cr,
    }

    enum indent-kind {
        space,
        tab,
    }

    record indentation {
        kind: indent-kind,
        unit: string,
    }

    enum raw-trivia-kind {
        whitespace,
        line-comment,
        block-comment,
        line-ending,
    }

    record raw-trivia {
        kind: raw-trivia-kind,
        text: string,
        span: mapped-span,
    }

    record raw-line {
        number: u64,
        raw-text: string,
        line-ending: line-ending,
        span: mapped-span,
        content-span: mapped-span,
        line-ending-span: mapped-span,
        indentation: raw-trivia,
        trailing-trivia: list<raw-trivia>,
    }

    enum raw-node-kind {
        blank,
        comment,
        simple,
        section,
        invalid,
    }

    record unexpected-indentation {
        expected-level: u32,
        actual-level: u32,
    }

    variant raw-invalid-reason {
        mixed-indentation,
        invalid-indentation,
        unexpected-indentation(unexpected-indentation),
    }

    enum raw-diagnostic-code {
        mixed-indentation,
        invalid-indentation,
        unexpected-indentation,
        empty-section,
        unclosed-block-comment,
    }

    enum raw-diagnostic-severity {
        error,
        warning,
    }

    record raw-related-span {
        message: string,
        span: mapped-span,
    }

    record raw-diagnostic {
        code: raw-diagnostic-code,
        severity: raw-diagnostic-severity,
        message: string,
        span: mapped-span,
        related: list<raw-related-span>,
    }

    record raw-tree-node {
        id: node-id,
        kind: raw-node-kind,
        text: string,
        span: mapped-span,
        line: raw-line,
        code-span: option<mapped-span>,
        header-span: option<mapped-span>,
        body-span: option<mapped-span>,
        indent-level: option<u32>,
        invalid-reason: option<raw-invalid-reason>,
        syntax-context: syntax-context-id,
        parent: option<node-id>,
        children: list<node-id>,
    }

    record raw-tree {
        roots: list<node-id>,
        nodes: list<raw-tree-node>,
        diagnostics: list<raw-diagnostic>,
        indentation: option<indentation>,
    }

    type generated-node-id = u64;

    enum generated-raw-node-kind {
        blank,
        comment,
        simple,
        section,
    }

    record generated-raw-node {
        id: generated-node-id,
        kind: generated-raw-node-kind,
        text: string,
        children: list<generated-node-id>,
    }

    record generated-raw-tree {
        roots: list<generated-node-id>,
        nodes: list<generated-raw-node>,
    }

    enum retained-children-placement {
        prepend,
        append,
    }

    record retained-children {
        target: generated-node-id,
        placement: retained-children-placement,
    }

    record replace-node-edit {
        replacement: generated-raw-tree,
        retained-children: option<retained-children>,
    }

    variant tree-edit {
        replace-node(replace-node-edit),
        replace-children(generated-raw-tree),
    }
    variant capture-value {
        text(string),
        node(node-id),
        nodes(list<node-id>),
        span(mapped-span),
    }

    record capture {
        name: string,
        value: capture-value,
    }

    record ast-node {
        id: node-id,
        kind: syntax-kind,
        syntax-id: string,
        span: mapped-span,
        syntax-context: syntax-context-id,
        captures: list<capture>,
        children: list<node-id>,
    }

    record ast-tree {
        roots: list<node-id>,
        nodes: list<ast-node>,
    }

    record syntax-definition-payload {
        kind: syntax-kind,
        syntax-id: string,
        patterns: list<string>,
    }

    record exact-registration-payload {
        registration-id: string,
        definition: syntax-definition-payload,
    }

    record document-payload {
        text: string,
    }

    record preprocess-payload {
        text: string,
        span: mapped-span,
    }

    record line-payload {
        line-number: u64,
        text: string,
        span: mapped-span,
    }

    record node-payload {
        node: raw-tree-node,
    }

    enum matching-scope {
        definition,
        registration,
        pattern,
        element,
    }

    enum matching-timing {
        before,
        after,
    }

    enum matching-status {
        pending,
        matched,
        failed,
    }

    variant matching-path-segment {
        element(u32),
        branch(u32),
    }

    record matching-payload {
        input: string,
        pattern: option<string>,
        definition-id: string,
        registration-id: string,
        pattern-index: option<u64>,
        element-path: list<matching-path-segment>,
        pattern-span: option<text-range>,
        scope: matching-scope,
        timing: matching-timing,
        input-range: text-range,
        span: mapped-span,
        status: matching-status,
        failure-reason: option<string>,
        metadata: list<metadata-entry>,
    }

    record capture-payload {
        syntax-id: string,
        captures: list<capture>,
        span: mapped-span,
    }

    record candidate-payload {
        syntax-id: string,
        registration-id: string,
        score: s64,
        span: mapped-span,
    }

    record scope-payload {
        scope-id: u64,
        parent-scope: option<u64>,
        span: mapped-span,
    }

    variant hook-payload {
        document(document-payload),
        preprocess(preprocess-payload),
        line(line-payload),
        tree(raw-tree),
        node(node-payload),
        matching(matching-payload),
        expression(expression-payload),
        registered-expression(registered-expression-payload),
        condition(condition-payload),
        effect(effect-payload),
        section(section-payload),
        structure(structure-payload),
        capture(capture-payload),
        syntax(syntax-definition-payload),
        exact-registration(exact-registration-payload),
        candidate(candidate-payload),
        scope(scope-payload),
        ast(ast-tree),
        diagnostic(diagnostic),
        parser(parse-request),
    }

    record hook-invocation {
        context: invocation-context,
        target: hook-target,
        phase: hook-phase,
        payload: hook-payload,
        parse-results: list<parse-result>,
    }

    record hook-output {
        decision: hook-decision,
        replacement: option<hook-payload>,
        effects: hook-effects,
    }

    record text-edit {
        range: text-range,
        replacement: string,
        anchor: option<u64>,
    }

    record text-macro-input {
        context: invocation-context,
        text: string,
        span: mapped-span,
    }

    record text-macro-output {
        decision: hook-decision,
        edits: list<text-edit>,
        effects: hook-effects,
    }

    record tree-macro-input {
        context: invocation-context,
        tree: raw-tree,
        target: node-id,
        depth: u32,
    }

    record tree-macro-output {
        decision: hook-decision,
        edit: option<tree-edit>,
        effects: hook-effects,
    }
    record ast-macro-input {
        context: invocation-context,
        tree: ast-tree,
    }

    record ast-macro-output {
        decision: hook-decision,
        replacement: option<ast-tree>,
        effects: hook-effects,
    }

    enum addon-error-kind {
        incompatible-abi,
        unsupported-capability,
        unsupported-hook,
        invalid-payload,
        internal,
    }

    record addon-error {
        kind: addon-error-kind,
        message: string,
        diagnostics: list<diagnostic>,
    }
}
